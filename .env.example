PORT=3000
APP_ORIGIN=http://localhost:3000

# Set this to the exact verified email used by your owner/admin account.
ADMIN_EMAIL=tanveerlove999999@gmail.com

# Choose a private, unlinked path for your owner console; change this to your own random path.
OWNER_PANEL_PATH=/owner-9f4c2b7e

# Firebase Admin SDK service-account file path; keep file outside public/.
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Web App settings (public config values; not service-account secrets)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Cloud database: this starter uses local SQLite for development.
# For production, migrate deposits/users to a managed PostgreSQL database.
DATABASE_URL=

# Payment provider placeholders. Do not enable real payments until approved/configured.
PAYMENTS_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
